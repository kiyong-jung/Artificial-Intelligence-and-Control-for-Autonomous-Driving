  "common": ["--input", "obs33", "--policy", "mlp", "--hidden-layers", "256,256",
             "--epochs", "200", "--batch-size", "1024", "--lr", "1e-3",
             "--lr-schedule", "cosine", "--min-lr", "1e-5", "--patience", "40", "--accel-bins", "21",
             "--lane-weighting", "effective", "--cb-beta", "0.9999", "--lane-weight-cap", "100"],
  "experiments": {
    "base":         [],
    "lane_inverse": ["--lane-weighting", "inverse", "--lane-weight-cap", "50"],
    "lane_focal":   ["--lane-loss", "focal", "--focal-gamma", "2"],
    "small128":     ["--hidden-layers", "128,128"]
  }
